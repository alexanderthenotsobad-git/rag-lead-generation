# Copy to .env and fill in. Never commit .env.
#
# Hugging Face Inference API (embeddings, 384 dims)
HUGGINGFACE_API_TOKEN=
# Pinecone serverless
PINECONE_API_KEY=
PINECONE_INDEX_NAME=rag-lead-idx
PINECONE_NAMESPACE=restaurants
# Google Places API (New) -- Text Search
GOOGLE_PLACES_API_KEY=
# HasData Google Maps Reviews (10 credits per call)
HASDATA_API_KEY=
# DeepSeek (OpenAI-compatible)
DEEPSEEK_API_KEY=

# auto: live when the required keys for a command exist, else mock
# live: fail fast if keys are missing
# mock: never call an API
RAG_MODE=auto
